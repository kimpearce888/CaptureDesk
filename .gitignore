# CaptureDesk project ignores
node_modules/
build/
tools/
# dist/ holds release build output (setup exe, extension zip, checksums).
# It is produced by scripts and CI on demand — never commit build output:
# the GitHub Release assets are the single source of published binaries.
dist/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

