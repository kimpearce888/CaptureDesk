{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaptureDesk",
  "version": "2.0.0-alpha.1",
  "identifier": "app.capturedesk.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CaptureDesk Desktop",
        "url": "dashboard/index.html",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "background": "#0B1220"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/**", "$APPDATA/**", "$TEMP/**", "$DOCUMENT/**", "$DOWNLOAD/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["engine/*"],
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "perUser"
      }
    }
  }
}
