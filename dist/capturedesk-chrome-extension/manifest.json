{
  "manifest_version": 3,
  "name": "CaptureDesk",
  "version": "1.0.0",
  "description": "Screen recorder for tabs, windows, and your full desktop — camera bubble, microphone, cursor & click highlights, instant local saving. 100% on-device.",
  "minimum_chrome_version": "116",
  "offline_enabled": true,
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "CaptureDesk",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/sw/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "tabCapture",
    "desktopCapture",
    "offscreen",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"]
}
